{
  "manifest_version": 3,
  "name": "coIA-01",
  "version": "1.0.4",
  "description": "Abre o Google AI Studio na barra lateral do Chrome via coIA-01",
  "permissions": [
    "sidePanel",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "contextMenus",
    "storage"
  ],
  "host_permissions": [
    "https://aistudio.google.com/*",
    "https://gemini.google.com/*",
    "https://chat.deepseek.com/*",
    "https://chatgpt.com/*",
    "https://claude.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "favicons/favicon-16x16.png",
    "32": "favicons/favicon-32x32.png",
    "48": "favicons/favicon-48x48.png",
    "64": "favicons/favicon-64x64.png",
    "128": "favicons/favicon-128x128.png"
  },
  "action": {
    "default_title": "Abrir AI Studio",
    "default_icon": {
      "16": "favicons/favicon-16x16.png",
      "32": "favicons/favicon-32x32.png",
      "48": "favicons/favicon-48x48.png",
      "64": "favicons/favicon-64x64.png",
      "128": "favicons/favicon-128x128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
